{
  "name": "jabkit",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build --filter=!@jabkit/minimal --filter=!@jabkit/neo-brutalism --filter=!@jabkit/editorial --filter=!@jabkit/luxury --filter=!@jabkit/retro",
    "build:design-systems": "turbo run build --filter=@jabkit/minimal --filter=@jabkit/neo-brutalism --filter=@jabkit/editorial --filter=@jabkit/luxury --filter=@jabkit/retro",
    "build:design-systems:affected": "tsx scripts/build-affected-design-systems.ts",
    "dev": "pnpm --parallel --filter @jabkit/showcase --filter @jabkit/minimal --filter @jabkit/neo-brutalism --filter @jabkit/editorial --filter @jabkit/luxury --filter @jabkit/retro dev",
    "storybook": "pnpm --filter @jabkit/ui storybook",
    "storybook:build": "pnpm --filter @jabkit/ui storybook:build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck --filter=!@jabkit/minimal --filter=!@jabkit/neo-brutalism --filter=!@jabkit/editorial --filter=!@jabkit/luxury --filter=!@jabkit/retro",
    "typecheck:design-systems": "turbo run typecheck --filter=@jabkit/minimal --filter=@jabkit/neo-brutalism --filter=@jabkit/editorial --filter=@jabkit/luxury --filter=@jabkit/retro",
    "check:conventions": "tsx scripts/check-conventions.ts",
    "check:design-system-assets": "tsx scripts/check-design-system-assets.ts",
    "registry:build": "pnpm --filter @jabkit/build-registry build",
    "registry:verify": "pnpm registry:build && git diff --exit-code -- apps/showcase/public/r",
    "assets:vendor": "tsx scripts/vendor-remote-assets.ts",
    "previews:build": "tsx scripts/build-preview-assets.ts",
    "previews:verify": "tsx scripts/verify-preview-assets.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:conventions && pnpm check:design-system-assets && pnpm registry:verify && pnpm previews:verify",
    "release:cli": "pnpm --filter @jabkit/cli exec npm version --no-git-tag-version",
    "dev:design-systems": "pnpm --parallel --filter @jabkit/minimal --filter @jabkit/neo-brutalism --filter @jabkit/editorial --filter @jabkit/luxury --filter @jabkit/retro dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "gifenc": "^1.0.3",
    "husky": "^9.1.7",
    "playwright": "^1.51.1",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3"
  }
}
